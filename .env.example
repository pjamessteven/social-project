# Redis Configuration
REDIS_URL=redis://redis:6380

# Qdrant Configuration
QDRANT_URL=http://qdrant:6333

# OpenRouter API Key for best rates on Kimi, Deepseek and GPT chat completion models
OPENROUTER_KEY=

# Hetzner AI Inference API Key (primary chat provider)
HETZNER_KEY=

# OpenAI Key used for embedding models
OPENAI_API_KEY=

# Embedding Model Configuration
EMBEDDING_MODEL=text-embedding-3-large

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_DAY=
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_PER_HOUR=

# Database pool and timeout
DB_POOL_MAX=40
DB_TIMEOUT_MS=10000

# Concurrency limit (max simultaneous LLM workflows)
MAX_CONCURRENT_WORKFLOWS=20

# LLM stream timeout (ms) - max time to wait for a chunk from the LLM
LLM_STREAM_TIMEOUT_MS=180000

# Trusted proxy configuration
# If behind Cloudflare + nginx, the default (no config needed) is correct:
# cf-connecting-ip and x-real-ip are used automatically and cannot be spoofed.
# Only set these if using x-forwarded-for and you need to trust a specific number of proxies.
TRUSTED_PROXY_IPS=
TRUSTED_PROXY_COUNT=

# Captcha message limit (messages before captcha required)
CAPTCHA_MESSAGE_LIMIT=1

# Captcha message limit per chat (messages before captcha required within the same chat)
CAPTCHA_CHAT_MESSAGE_LIMIT=10

# Follow up questions
SUGGEST_NEXT_QUESTIONS=true

# Component Directories
DETRANS_COMPONENTS_DIR=components/detrans

# EMAIL
ZOHO_EMAIL=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNT_ID=

